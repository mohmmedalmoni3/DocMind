OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_MODEL=llama3.2:3b
EMBEDDING_MODEL=bge-m3
# Multilingual Arabic/English default. Changing embedding models requires re-ingestion.
DOCS_DIR=./docs
INDEX_DIR=./data
TOP_K=5
# Short answers use fewer passages; detailed answers keep TOP_K.
BRIEF_TOP_K=3
# Quote explicit supported facts without generation in brief mode.
DIRECT_FACTS=true
CHUNK_TOKENS=500
CHUNK_OVERLAP=80
MIN_SIMILARITY=0.30
OLLAMA_TIMEOUT_MS=180000
# Keep models warm; context grows automatically to fit long evidence.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_SIZE=4096
ANSWER_MAX_TOKENS=640
MAX_UPLOAD_MB=20
NEXT_TELEMETRY_DISABLED=1
# Lock the committee model: missing model becomes an error, never a silent fallback.
OLLAMA_STRICT_MODEL=false
SERVICE_ROUTING=true
# chunks (default) or whole for a bounded full-service context experiment.
SERVICE_CONTEXT=chunks
SERVICE_CONTEXT_TOKENS=3000
