{
  "name": "docmind",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "competition": "node scripts/competition.mjs",
    "competition:ingest": "node scripts/competition.mjs --ingest",
    "benchmark:challenge": "node scripts/challenge.mjs",
    "demo:government": "node scripts/government-demo.mjs start",
    "benchmark:government": "node scripts/government-demo.mjs benchmark",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "ingest": "tsx --env-file=.env scripts/ingest.ts",
    "ask": "tsx --env-file=.env scripts/ask.ts",
    "test": "tsx --test tests/*.test.ts",
    "benchmark": "tsx --env-file=.env scripts/benchmark.ts performance.json --replay",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "setup:voice": "node scripts/setup-voice.mjs",
    "prebuild": "node scripts/pdf-assets.mjs",
    "predev": "node scripts/pdf-assets.mjs",
    "postinstall": "node scripts/pdf-assets.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "next": "14.2.35",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "^6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
