# Explicit approved model required; no automatic pull or fallback.
OLLAMA_MODEL=EXACT_ORGANIZER_MODEL_TAG
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_SIZE=16384
OLLAMA_OUTPUT_TOKENS=900
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_PROMPT_CHARS=24000
OLLAMA_CIRCUIT_FAILURES=2
# Diagnostic generated text, disabled by default. Never publish these traces.
OLLAMA_TRACE=false
